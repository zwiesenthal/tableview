{
  "name": "tableview",
  "private": true,
  "version": "0.1.0",
  "description": "A fast macOS database client for Postgres, MySQL and SQLite, in the style of TablePlus, with Claude built in.",
  "license": "MIT",
  "author": "Zach Wiesenthal",
  "repository": {
    "type": "git",
    "url": "https://github.com/zwiesenthal/tableview"
  },
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "app": "node scripts/build-app.mjs",
    "test:js": "node --experimental-strip-types --test tests/js/*.test.ts",
    "test": "npm run build && cd src-tauri && cargo test",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/state": "^6.7.6",
    "@glideapps/glide-data-grid": "^6.0.3",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-opener": "^2",
    "@uiw/react-codemirror": "^4.25.12",
    "apache-arrow": "^21.2.0",
    "dompurify": "^3.4.18",
    "echarts": "^6.1.0",
    "lodash": "^4.18.1",
    "lucide-react": "^1.73.0",
    "marked": "^18.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-responsive-carousel": "^3.2.23",
    "tslib": "^2.9.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "knip": "^6.45.1",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.0.16"
  }
}
